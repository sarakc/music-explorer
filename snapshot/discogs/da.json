{"/api/discogs/artist/11686004/profile":{"cached":true,"profile":{"id":"11686004","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:artist:11686004","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/11686004-Lucidbeatz","type":"artist","urls":[]}},"/api/discogs/artist/1810602/profile":{"cached":true,"profile":{"id":"1810602","image":"https://i.discogs.com/aYFfgKwBqbV8bAlaJnqCkNfnJS5p-uNWtX9oe8PzkoU/rs:fit/g:sm/q:90/h:400/w:400/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE4MTA2/MDItMTMwNTQ2MjA5/OS5qcGVn.jpeg","imageThumb":"https://i.discogs.com/5mNk-tD-1m4LY21nlYns7g7Rx5Cg4kfAxQErXTTAejk/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE4MTA2/MDItMTMwNTQ2MjA5/OS5qcGVn.jpeg","profile":"Skip Club Orchestra is a solo project by Hiroshima resident Tatsuya Sasaki. Having influenced by techno music, he started making tracks in 1995 and started the solo project \"Skip Club Orchestra\" in 2002. At initial phase of the project, he mainly made tracks in studio, creating the sound centering around techno/house. From 2003 he started to perform the live show with laptop. His participation to live acts steered him to go deep in the direction of sound that is softer and have fuller groove from initial glitch sound. His live style is unconventional which ranges wide from jam session to band arrangement. His first album \"1 2003-2004\" was released in 2004, and EP \"EP1\" was released from digital label Kirapica in 2008. Now his 2nd album \"Leap & Stagnation\" will be out soon.","provider":"discogs","ref":"discogs:artist:1810602","relations":{"aliases":[{"id":2306283,"name":"Tatsuya Sasaki"},{"id":3197668,"name":"Drumatix Blow"}],"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/1810602-Skip-Club-Orchestra","type":"artist","urls":["http://soundcloud.com/skipcluborchestra"]}},"/api/