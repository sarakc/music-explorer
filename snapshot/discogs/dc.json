Wlt/YWdlcy9BLTUxMDg3/LTEzNjYwNDc1NTgt/Mjc2NS5wbmc.jpeg","profile":"Total is an American R&B girl group originally from the Plainfield, New Jersey, United States, and one of the signature acts of Sean Combs' Bad Boy Records imprint during the 1990s. The group consisted of members Kima Raynor, Keisha Spivey, and Pamela Long. Total is best known for their feature on Mase's \"What You Want\", as well as their hits \"Kissin' You\", \"Can't You See\" (featuring The Notorious B.I.G.), and \"What About Us?\" and \"Trippin'\", both featuring Missy Elliott. Long was also featured on The Notorious B.I.G.'s hit song \"Hypnotize\", singing the chorus. Total made their first appearance singing the hook on The Notorious B.I.G.'s debut single, \"Juicy\".","provider":"discogs","ref":"discogs:artist:51087","relations":{"aliases":null,"groups":null,"members":[{"active":true,"id":181337,"name":"Pamela Long"},{"active":true,"id":1511557,"name":"Jakima Raynor"},{"active":true,"id":4553564,"name":"Keisha Spivey"}],"namevariations":["Total Discipline"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/51087-Total","type":"artist","urls":["https://en.wikipedia.org/wiki/Total_(girl_group)","https://www.instagram.com/totalevolution95/"]}},"/api/discogs/label/1195543/profile":{"cached":true,"profile":{"id":"1195543","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:label:1195543","relations":{"parentLabel":{"id":1726487,"name":"Cinq Music Group, LLC"},"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/1195543-Cinq-Music-Group","type":"label","urls":[]}},"/api/discogs/label/1204470/profile":{"cached":true,"profile":{"id":"1204470","image":"https://i.discogs.com/rrajoo8L6jgeNNfOeIofZvUlLEWEaCEvmX7rTXAMHDY/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTEyMDQ0/NzAtMTUxNzA0NTQy/NS01NzYwLnBuZw.jpeg","imageThumb":"https://i.discogs.com/1uAjVCTuMQ_XS-CD2QW-XYkrlMzJpZbUO8RU_WYFztw/rs:fit/g:sm/q:40/h:150/w:150/c