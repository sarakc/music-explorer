10","relations":{"aliases":[{"id":6046240,"name":"Bryan Mooney"},{"id":6675353,"name":"DJ Moonbeam"},{"id":10049680,"name":"DJ Too Hard"}],"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/6849710-New-Members","type":"artist","urls":["http://www.facebook.com/DJMoonbeam1994","http://www.instagram.com/_newmembers_/","http://newmembers.bandcamp.com/","http://soundcloud.com/newmembers"]}},"/api/discogs/artist/7049425/profile":{"cached":true,"profile":{"id":"7049425","image":"https://i.discogs.com/NR_ny71sBLl2BnvkTH97P9uEmXIt_jNEAoXyJ4UD6R8/rs:fit/g:sm/q:90/h:500/w:500/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTcwNDk0/MjUtMTY3MjY5MTk4/Mi04NjQwLmpwZWc.jpeg","imageThumb":"https://i.discogs.com/iNNJbvVjL0lNOsz2uIu2XMPolAmDgXsY6Xjr3ZseyGs/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTcwNDk0/MjUtMTY3MjY5MTk4/Mi04NjQwLmpwZWc.jpeg","profile":"","provider":"discogs","ref":"discogs:artist:7049425","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/7049425-sel6","type":"artist","urls":["https://sel6.bandcamp.com","https://soundcloud.com/sel_6","https://www.instagram.com/sel.6/","https://twitter.com/sel6ix"]}},"/api/discogs/artist/7996/profile":{"cached":true,"profile":{"id":"7996","image":"https://i.discogs.com/75Ljtb9tLWXfbOZ4hTzZQDeTmTF0e-C-6Qhtj42KdW0/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTc5OTYt/MTMwODE4MDY4Ni5q/cGVn.jpeg","imageThumb":"https://i.discogs.com/7_0bL7hz4yya1qLseInUY8SbErJQVuxfZxpZcxskjho/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTc5OTYt/MTMwODE4MDY4Ni5q/cGVn.jpeg","profile":"Kim English (6 September 1970 – 2 April 2019) was a Chicago-born vocalist and songwriter who became one of the most recognizable voices in 1990s and 2000s house music. Raised singing gospel music, she attended Kenwood Academy High School, studying under renowned vocal coach Lena McLin.\n\nHer breakthrough came in the early 1990s when Chicago house producer [a=Gershon Jackson] introduced her to [a=Byron Stingily] of [a=Ten City]. Together, they co-wrote her 1994 debut single, \"Nite Life\". The track caught the attention of New York dance staple [l=Nervous Records], where English remained a flagship artist throughout her career. Famous remixes by producers such as [a=Masters At Work], [a=Armand Van Helden], [a=Mood II Swing], [a=David Morales], and [a=François K] helped propel her rich, soulful alto into international club rotation.\n\nEnglish dominated the US Billboard Hot Dance Club Play chart, landing eight consecutive #1 or #2 singles between 1999 and 2007. Five of those reached #1: \"Unspeakable Joy\", \"Missing You\", \"Bumpin' & Jumpin'\", \"Everyday\", and \"Treat Me Right\". Known for fusing house grooves with uplifting, faith-filled lyrics, she released studio albums including Higher Things (1998) and My Destiny (2006) alongside several remix compilations.\n\nShe passed away in Chicago on April 2, 2019, from kidney failure at age 48.\n[l=Simply English Music] is her music publishing entity. \n","provider":"discogs","ref":"discogs:artist:7996","relations":{"aliases":null,"groups":null,"members":null,"namevariations":["English","English, Kim","K English","K. E. English","K. English","Ki English","Kim E. English"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/7996-Kim-English","type":"artist","urls":["https://www.facebook.com/Kim.English.Music","https://myspace.com/thekimenglish","https://en.wikipedia.org/wiki/Kim_English"]}},"/api/discogs/artist/80323/profile":{"cached":true,"profile":{"id":"80323","image":"https://i.discogs.com/bpWvHyGZ0mb3t6J8t_HbxyfgTtr2dvxsgd7U4e5ix9E/rs:fit/g:sm/q:90/h:599/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTgwMzIz/LTE0MjkzNzg5ODQt/NTMyMi5qcGVn.jpeg","imageThumb":"https://i.discogs.com/mpToZtcTmLoV22vs2biASC770PmMUnJ0QnNlz9QYcHM/rs:fit/g:sm/q:40/h:150/