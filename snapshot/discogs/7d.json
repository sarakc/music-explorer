:"discogs","ref":"discogs:artist:6765292","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/6765292-Luedji-Luna","type":"artist","urls":["https://www.instagram.com/luedjiluna/","https://www.youtube.com/channel/UCaLmDMn4wJHNjBYfJ7n1TZg","https://luedjiluna.bandcamp.com/"]}},"/api/discogs/artist/7428282/profile":{"cached":true,"profile":{"id":"7428282","image":"https://i.discogs.com/h0nG9x8bshzKaPd9DYaI0D2Nn1HeJfSmoNsPtSaFmcA/rs:fit/g:sm/q:90/h:225/w:225/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTc0Mjgy/ODItMTczMzUyMDY2/NC05MTg2LmpwZWc.jpeg","imageThumb":"https://i.discogs.com/e7vZxFZiHqXofTbj-kKNQjA_rO4eDLuWwzFVZosA2lI/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTc0Mjgy/ODItMTczMzUyMDY2/NC05MTg2LmpwZWc.jpeg","profile":"Nigerian singer-songwriter, composer, sound engineer and record producer","provider":"discogs","ref":"discogs:artist:7428282","relations":{"aliases":[{"id":18150168,"name":"Austin Iwar"}],"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/7428282-Tay-Iwar","type":"artist","urls":[]}},"/api/discogs/artist/84911/profile":{"cached":true,"profile":{"id":"84911","image":"https://i.discogs.com/TRgUKJ72BhYnhcZxJLrPKvDa84zX0FapDL6B4fazL8k/rs:fit/g:sm/q:90/h:336/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTg0OTEx/LTE0OTgzODYyMzMt/Mjc4Ni5qcGVn.jpeg","imageThumb":"https://i.discogs.com/q3y_epV-X70eMUEad1inDGxeexQaEpIh5wMqFgAW0bM/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTg0OTEx/LTE0OTgzODYyMzMt/Mjc4Ni5qcGVn.jpeg","profile":"American anti-folk / lo-fi act originally conceived as a pseudonym for Adam Green in 1994. By 1998 The Moldy Peaches became a duo when a friend and collaborator Kimya Dawson joined as a full member. From 1999 onwards Moldy Peaches became a full band, with a shifting lineup of second guitarists, drummers, and bassists. The lineup