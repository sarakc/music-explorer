{"/api/discogs/artist/13441/profile":{"cached":true,"profile":{"id":"13441","image":"https://i.discogs.com/e_MtHAf1yY5uFjII1EX3G8E3JBW8Tqkt-U1w8Yrbhfs/rs:fit/g:sm/q:90/h:378/w:252/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTEzNDQx/LTEyNjU4NTg0MDYu/anBlZw.jpeg","imageThumb":"https://i.discogs.com/NdDH4vpdG3y__JuROQyXddjc8nf92eFzUGUSIFpcA8A/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTEzNDQx/LTEyNjU4NTg0MDYu/anBlZw.jpeg","profile":"Chicago footwork producer. Owns [l=Beatdown House].","provider":"discogs","ref":"discogs:artist:13441","relations":{"aliases":[{"id":2850181,"name":"Clenton Hill"},{"id":7920568,"name":"Clenton Gosberry"}],"groups":null,"members":null,"namevariations":["Clent","D.J. Clent","DJ Clint"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/13441-DJ-Clent","type":"artist","urls":["http://soundcloud.com/djclent","https://djclent39.bandcamp.com/","https://www.facebook.com/dj.clent","https://twitter.com/DJCLENT39","https://www.youtube.com/watch?v=MtvWECFjulg"]}},"/api/discogs/artist/15252777/profile":{"cached":true,"profile":{"id":"15252777","image":"https://i.discogs.com/KPXn_VFsxdRLoJ3vVFGuMhLT3KByytsYhCLpTTkRPTw/rs:fit/g:sm/q:90/h:600/w:480/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE1MjUy/Nzc3LTE3MzAxNDYz/OTAtNDYzNy5qcGVn.jpeg","imageThumb":"https://i.discogs.com/s78fqSbH_PWfqSD-ifehGGll_HAQMUdIoPI8dMlakJw/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE1MjUy/Nzc3LTE3MzAxNDYz/OTAtNDYzNy5qcGVn.jpeg","profile":"YYARD represents a musical project of pianist, keyboarder and producer Yannis Anft with roots in Cologne and Berlin. Anft draws inspiration from his many years of experience as a jazz pianist, dancing through nights in clubs and his enthusiasm for other genres of music and art forms.\r\nBorn in 1993, Anft started playing the piano at the age of 11. From 2013 to 2019, he studied jazz piano at the Hochschule für Musik und Tanz in Cologne. Since then he has been active as a pianist, keyboardist and producer.\r\nThe soundscape of YYARD‘s productions is characterized by playful textures, pulsating and driving grooves, as well as a loving and detailed sound design. Tempos and genre play a subordinate role.","provider":"discogs","ref":"discogs:artist:15252777","relations":{"aliases":[{"id":7464286,"name":"Yannis Anft"}],"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/15252777-YYARD","type":"artist","urls":["https://yyard.bandcamp.com","https://www.instagram.com/yyard_music/","https://soundcloud.com/yyard_music"]}},"/api/discogs/artist/173557/profile":{"cached":true,"profile":{"id":"173557","image":"https://i.discogs.com/AWPq_Zbj7ExccAXJoBsMKnueJpLcKEhwhMQsnZv7Iac/rs:fit/g:sm/q:90/h:480/w:480/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE3MzU1/Ny0xNzYxODMxNzEw/LTU1OTUuanBlZw.jpeg","imageThumb":"https://i.discogs.com/6r7HdDeUtpbkFa3DK3vYwHFXexvFSqJ5RkYkc6qmGdo/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE3MzU1/Ny0xNzYxODMxNzEw/LTU1OTUuanBlZw.jpeg","profile":"Rapper from Houston, Texas. Born on December 4, 1970 - died on February 3, 1998. \r\nA prominent member in [url=https://www.discogs.com/artist/194282-DJ-Screw-2]DJ Screw[/url]'s group, [a=The Screwed Up Click]. Shot and killed in 1998 before the release of his first & only solo album [m=212276].\r\nBrother of [a=H.A.W.K.] who also passed away in 2006.","provider":"discogs","ref":"discogs:artist:173557","relations":{"aliases":[{"id":1656641,"name":"Patrick Hawkins (3)"}],"groups":null,"members":null,"namevariations":["Fat Pat (R.I.P)","Fat Pat's","Fat Pats","FatPat","Legendary Mr. Fat Pat (RIP), The","Pat","Phat Pat","The Late Great Fat Pat"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/173557-Fat-Pat","type":"artist","urls":["https://www.myspace.com/patricklamonthawkins"]}},"/api/discogs/artist/3268681/profile":{"cached":true,"profile":{"id":"3268681","image":"","imageThumb":"","p