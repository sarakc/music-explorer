es":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/8251173-Salush","type":"artist","urls":[]}},"/api/discogs/artist/9708481/profile":{"cached":true,"profile":{"id":"9708481","image":"https://i.discogs.com/DSJ0XiUyi1FnmSh6Y830-2UuKztGTAgY-tkzRTx8qeg/rs:fit/g:sm/q:90/h:400/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTk3MDg0/ODEtMTcxNDY0Mzc1/NC02NjkwLmpwZWc.jpeg","imageThumb":"https://i.discogs.com/65LhfqaTVox9hZb04n4H9QEOhmWy5z4CO4V-IgLOxY4/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTk3MDg0/ODEtMTcxNDY0Mzc1/NC02NjkwLmpwZWc.jpeg","profile":"","provider":"discogs","ref":"discogs:artist:9708481","relations":{"aliases":null,"groups":null,"members":null,"namevariations":["eira haul"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/9708481-Eira-Haul","type":"artist","urls":[]}},"/api/discogs/label/1709027/profile":{"cached":true,"profile":{"id":"1709027","image":"","imageThumb":"","profile":"Helsinki based electronic music label run by Antti Salonen.","provider":"discogs","ref":"discogs:label:1709027","relations":{"parentLabel":null,"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/1709027-Avoidance","type":"label","urls":[]}},"/api/discogs/label/1815040/profile":{"cached":true,"profile":{"id":"1815040","image":"https://i.discogs.com/se2mDpm0N1sKlE80_HmL80PAFl8iIlzyLqsUg2q1wfM/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTE4MTUw/NDAtMTU4OTczNzk2/MS04MTE0LmpwZWc.jpeg","imageThumb":"https://i.discogs.com/y03kf-fXHOTECjKVPKk4fN36CS95hsjO6Di_koD9ouc/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTE4MTUw/NDAtMTU4OTczNzk2/MS04MTE0LmpwZWc.jpeg","profile":"Label located in Paris, France (EU), run buy DVDE.","provider":"discogs","ref":"discogs:label:1815040","relations":{"parentLabel":null,"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/1815040-House-Of-Underground","type":"label","urls":["https://www.instagram.com/houseofunderground","https://soundcloud.com/houseofunderground","https://houseofunderground.bandcamp.com"]}},"/api/discogs/label/19735/profile":{"cached":true,"profile":{"id":"19735","image":"https://i.discogs.com/BIT6nxa7OTh-_xfH9s-Bo8yP-pgnjb0lcdDVNTkIFUk/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTE5NzM1/LTE0OTc2OTc5NjAt/NTUxMi5wbmc.jpeg","imageThumb":"https://i.discogs.com/t5A4tX-v5UBo6z_EXpoE6VEQ6DchnsyIOG4-qTMgo2c/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTE5NzM1/LTE0OTc2OTc5NjAt/NTUxMi5wbmc.jpeg","profile":"Founded by [url=https://www.discogs.com/artist/176613-James-Smith]James[/url] \"[a207034]\" [url=https://www.discogs.com/artist/176613-James-Smith]Smith[/url] and [a192153] in 1986, Rap-A-Lot Records is a hip-hop and R&B music label, headquartered in Smith's hometown of Houston, Texas. Upon foundation and local notoriety, it soon became a prominent independent hip-hop label in the Gulf Coast region of the United States.\r\n\r\nIn 1987, the label initiated a distribution deal with [l=Def Jam Recordings], but former parent company [l=Sony Music] rejected the idea. It then received its first signage, a Houston-based gangsta rap group, the [a=Geto Boys], put together by the label's co-founder, J. Prince. In 1989, Rap-A-Lot negotiated a deal with [a=Rick Rubin]'s [l=American Recordings] (formerly [l=Def American Recordings]) to release the group's sophomore studio album, but [l=Geffen Records] (whose parent company at the time, [l=Warner Bros. Records]; now [l=Warner Records]) rejected the proposed negotiation, due to the album's lyrical nature and violent content. Warner eventually awarded Rap-A-Lot with a distribution deal with the aptly-titled [i][url=https://discogs.com/master/125838]Grip It! On that Other Level[/url][/i] eventually going platinum in ten months. A make-or-break moment for the label, Smith was on the verge of giving up from the industry and leaving Rap-A-Lot defunct until he learned of the album's success.\r\n\r\nIn 1991, the label signed with [l=Priority Records] to manufacture and distribute its music. Three years later, Rap-A-Lot then switched over to [l=Noo Trybe Records] (which was a subsidiary of [l=Virgin Records America, Inc.]) for distribution as a result of parent company [l=EMI]'s changes following its acquisition of Priority. Many of the label's classic albums released under Priority were re-issued through Noo Trybe in 1995. Also, in 1995, Cliff Blodget parted ways with Rap-A-Lot Records at the height of its success. At the same time, they expanded to a West Coast hip-hop audience with the formation of [l=Rap-A-Lot Records West].\r\n\r\nIn 1994, an R&B division was set up under Rap-A-Lot called [l=Sing-A-Lot Records]; later dissolved in 2000.\r\n\r\nUpon signing with the label in 1996, rapper [a=Yukmouth] formed a joint venture label with Rap-A-Lot called [l=Smoke-A-Lot Records]. In 1998, with Noo Trybe preparing for its closure, Virgin Records became the main parent label for Rap-A-Lot until 2004, due to yet another restructuring at parent company EMI; Virgin Records America would eventually be folded into sister label [l=Capitol Records].\r\n\r\nIn January 1999, Rap-A-Lot formed the [l=Rap-A-Lot 2K] millennium sublabel to prepare for the year 2000. The sublabel dissolved in December 2001. In January 2002, Rap-A-Lot Records began releasing music under the subtitle, [l=Rap-A-Lot 4 Life], and a 2000s relaunch called [l=Rap-A-Lot Resurrection], strategizing its resurgence in the new generation of music.\r\n\r\nIn 2003, the label was on the verge of launching a distribution platform ([l=Rap-A-Lot Distribution, Inc.]) with [l=Death Row Records] co-founder [a=Suge Knight] and [l=Murder Inc Records] co-CEO [a=Irv Gotti] (1970-2025). However, a federal investigation caused plans for the platform to be scrapped immediately.\r\n\r\nIn February 2004, [l=Asylum Records] became a distributing label for Rap-A-Lot Records. Two years later, Asylum was organized into [l=Warner Music Group]'s [l=Independent Label Group] (later [l=Alternative Distribution Alliance]). Then, in 2008, the label joined [l=Fontana Distribution] for future releases. Five years later, Rap-A-Lot signed another distribution deal with Sony's [l=RED Music (4)]; in 2017, Sony merged RED with [l=The Orchard].\r\n\r\nAs of 2018, Rap-A-Lot releases are now under the distributive control of [l=SoSouth]. The label, still under leadership of J. Prince, is also under management of [l=Mob Ties] (run by J. Prince's son, J. Prince, Jr).\r\n","provider":"discogs","ref":"discogs:label:19735","relations":{"parentLabel":{"id":1183619,"name":"SoSouth Music Distribution, LLC"},"sublabels":[{"id":40482,"name":"Interface (2)"},{"id":625923,"name":"Rap-A-Lot 2K"},{"id":27696,"name":"Rap-A-Lot 4 Life"},{"id":4629465,"name":"Rap-A-Lot 4 Life 40 Years"},{"id":109463,"name":"Rap-A-Lot Resurrection"},{"id":1271419,"name":"Sing-A-Lot Records"},{"id":73961,"name":"Smoke-A-Lot Records"},{"id":76318,"name":"Underground Records (6)"}]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/19735-Rap-A-Lot-Records","type":"label","urls":["http://www.rapalotrecords.com/","http://twitter.com/rapalot4life","http://en.wikipedia.org/wiki/Rap-A-Lot_Records","http://fr.wikipedia.org/wiki/Rap-A-Lot_Records"]}},"/api/discogs/label/25329/profile":{"cached":true,"profile":{"id":"25329","image":"https://i.discogs.com/Uh0S_8tRqOusW6HIw21f-YV7BIw43k2MEjktRHY7npY/rs:fit/g:sm/q:90/h:423/w:424/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTI1MzI5/LTEyNjEyNTQ0NjQu/anBlZw.jpeg","imageThumb":"https://i.discogs.com/rP6CldYpkGgmxe9tNE06mYQfVDAdJCfAbFWN7Td1Yp8/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTI1MzI5/LTEyNjEyNTQ0NjQu/anBlZw.jpeg","profile":"Japanese label based in Tokyo, run by [a591962].","provider":"discogs","ref":"discogs:label:25329","relations":{"parentLabel":null,"sublabels":[{"id":