lations":{"aliases":[{"id":2959405,"name":"Lauro Robles"}],"groups":null,"members":null,"namevariations":["Lauro Robles"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/505377-Lao","type":"artist","urls":["https://soundcloud.com/lao","https://www.facebook.com/laobass","https://twitter.com/laurorobles"]}},"/api/discogs/artist/6443613/profile":{"cached":true,"profile":{"id":"6443613","image":"https://i.discogs.com/jC4Y8rjr73rrbTMKgoaflt3gXpNe3xg8fvvXbyEwefs/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTY0NDM2/MTMtMTU1NDIyMTk4/MC02NjUwLmpwZWc.jpeg","imageThumb":"https://i.discogs.com/lqG_Ro480RdibyhMK9yIRLe7NsfGeVgXqWnYYKbrbrQ/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTY0NDM2/MTMtMTU1NDIyMTk4/MC02NjUwLmpwZWc.jpeg","profile":"DJ and Producer from Dublin, Ireland.","provider":"discogs","ref":"discogs:artist:6443613","relations":{"aliases":[{"id":9034702,"name":"Fionn Fahey"}],"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/6443613-Fio-Fa","type":"artist","urls":["http://fiofa.bandcamp.com/","http://soundcloud.com/fiofahhh","http://ra.co/dj/fiofa"]}},"/api/discogs/label/23482/profile":{"cached":true,"profile":{"id":"23482","image":"https://i.discogs.com/deOsz9ksR7R4Qnam1GiZUxULHhpGzTQE1CuqOe7bedA/rs:fit/g:sm/q:90/h:149/w:200/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTIzNDgy/LTE0NTUzMDM3NDQt/MjM5OC5qcGVn.jpeg","imageThumb":"https://i.discogs.com/Z-6XK9MqjFrEqBkhrmF_RH-7MG-fk00hDx85CD_yn44/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTIzNDgy/LTE0NTUzMDM3NDQt/MjM5OC5qcGVn.jpeg","profile":"Definitive Jux was initially known simply as Def Jux. However, popular hip hop label Def Jam Recordings sued Def Jux over the name similarity in 2001. This lawsuit was settled out of court and the name was officially changed to Definitive Jux.","provider":"discogs","ref":"discogs:label:23482","relations":{"parentLabel":{"id":358791,"name":"Definitive Jux, Inc."},"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/23482-Def-Jux","type":"label","urls":["http://www.definitivejux.net/","http://en.wikipedia.org/wiki/Definitive_Jux","http://www.nysun.com/on-the-town/recording-lyrics-to-change-the-world/1559/"]}},"/api/discogs/label/237/profile":{"cached":true,"profile":{"id":"237","image":"https://i.discogs.com/1rrViQveJmRumM48FWYOYNsJD3-iahuaYprtxJgsAQ0/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTIzNy0x/NjkyOTkxNjY2LTg2/NjgucG5n.jpeg","imageThumb":"https://i.discogs.com/2D4adn0ntBRljVGVLw5WZejP7jKuAMzVd6S208ifRwE/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTIzNy0x/NjkyOTkxNjY2LTg2/NjgucG5n.jpeg","profile":"Swedish label managed by Swedish DJ & producer [a=Adam Beyer], founded in 1996.\nAt first, it was a primarily Swedish-only techno label with local colleagues like [a=Jesper Dahlbäck], [a=Cari Lekebusch], [a=Thomas Krome], [a=Fredrick Almquist], [a=Joel Mull] and so on. Occasionally he invited international friends like [a=Oliver Ho], [a=Marco Carola] and various more to the remix compilation [m=134195]. Regarding to the previous, the small collective followed Adam on the more experimental road of sounds and these experiments continued on sublabels such as  [l=Code Red], Truesoul in 2002 (where he released his fourth album [m=28627]) and Mad Eye in 2004. He invited more artists from Sweden with the likes of [a=Hardcell], [a=Pär Grindvik], [a=Patrik Skoog], [a=Hertz] and [a=Henrik B] and released compilations like [m=802282] and [m=434878].\nAround the end of 2006, began with the release [m=1717458] by Pär Grindvik, Adam extended the label worldwide and turned the label's sound towards minimal. Beginning with artists like [a=Perc], [a=Ortin Cam] and the uprising of digital distribution, he made the label more active with the number of releases.\nIn 2013, he let the label and his own productions not necessarily related to techno, with becoming open for progressive and tech house. This turn was marked with the [m=1012220] compilation and began to push out releases in a monthly frequency.\nNowdays, Drumcode releases every kind of dance music, moving raw techno to the sublabel [l=DCLTD] completely and gravitating towards trancy influences, increasing the vocals and melodic elements of the label's sound significantly.","provider":"discogs","ref":"discogs:label:237","relations":{"parentLabel":{"id":1044330,"name":"Drumcode Records"},"sublabels":[{"id":1396700,"name":"A-Sides"},{"id":4118586,"name":"DCLTD"},{"id":2535319,"name":"Gainlane"},{"id":1195385,"name":"The Remixes (3)"}]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/237-Drumcode","type":"label","urls":["https://www.drumcode.se","https://drumcoderecords.bandcamp.com","https://www.facebook.com/drumcoderecords","https://www.instagram.com/drumcoderecords","https://soundcloud.com/drumcode","https://twitter.com/drumcoderecords","https://en.wikipedia.org/wiki/Drumcode_Records","https://www.youtube.com/drumcodeofficial"]}},"/api/discogs/label/3299229/profile":{"cached":true,"profile":{"id":"3299229","image":"https://i.discogs.com/CEmC-FfXqFVLcDdLtHpUCMIyVdGoEvLDK-sWz6x5Dh4/rs:fit/g:sm/q:90/h:110/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTMyOTky/MjktMTY4NjkwMTY5/MC03OTE1LnBuZw.jpeg","imageThumb":"https://i.discogs.com/aT7G6f1p29dePkEvjkhDxOEAInTt2UwAXyI8Rrzaolw/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTMyOTky/MjktMTY4NjkwMTY5/MC03OTE1LnBuZw.jpeg","profile":"Digital label run by French DJ's & producers [a=Amor Satyr] & [a=Siu Mata] (also known as duo [a=Sexapil]).\r\nStyles: Tribal/Tribe, Baile, Dembow, Bass Music...","provider":"discogs","ref":"discogs:label:3299229","relations":{"parentLabel":null,"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/3299229-WAJANG","type":"label","urls":["http://www.facebook.com/broworkk","http://www.instagram.com/