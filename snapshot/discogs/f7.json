thGang"]}},"/api/discogs/artist/3827356/profile":{"cached":true,"profile":{"id":"3827356","image":"","imageThumb":"","profile":"New Orleans bounce artist. ","provider":"discogs","ref":"discogs:artist:3827356","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/3827356-Keedy-Black","type":"artist","urls":["http://digitallibrary.tulane.edu/islandora/object/tulane%3A28451"]}},"/api/discogs/artist/41057/profile":{"cached":true,"profile":{"id":"41057","image":"https://i.discogs.com/2D9Vdf7vXNrVJEFsB_FX-qP4FeHWbqDdXUHKf4j4bIc/rs:fit/g:sm/q:90/h:600/w:545/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQxMDU3/LTE2NTgwMzMxMTEt/MzE4NS5qcGVn.jpeg","imageThumb":"https://i.discogs.com/SUiuNiyh4nYGrLOxW84gWvEwvD85FbRLVQSOugyCeRQ/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQxMDU3/LTE2NTgwMzMxMTEt/MzE4NS5qcGVn.jpeg","profile":"[a=Lady Tigra] (Rachel de Rougemont) and [a=Bunny D.] (Elana Cager) met in high school, and regularly attended Skylight Express, a teen-night dance club in Kendall that featured live performances by national hip-hop artists (including LL Cool J and Salt-N-Pepa), as well as local Miami bass music and artists such as [a75187] and the [a68747]. They were featured dancers on the syndicated TV show Miami Teen Express that was taped and aired every week throughout South Florida, Atlanta, Metro New York and was produced by Douglas Productions which produced a string of local and syndicated cable programs. The girls quickly struck up a friendship when they discovered their shared love of all things hip-hop. Tigra was an amateur graffiti artist, poet and break-dancer who wrote rhymes. Bunny D was a classically trained dancer and performer who also wrote hip-hop lyrics. The duo formed a group called XTC and would battle boys during their lunch period. Female emcees were a rarity at the time and the girls soon gained the attention of local rapper [a413630] of the group [a277128], who used to drive them home from school. One afternoon, [a413630] needed to stop by the [l27785] studios. During the meeting, Tigra and Bunny went into a recording booth and began rhyming for fun. [a104656] of [l27785] caught the girls and employed Larry Davis to construct some hook-oriented tracks for the group, around the girls' pre-written rhymes. Tigra was 15 years old and Bunny was 17 years old when the girls signed with [l27785].","provider":"discogs","ref":"discogs:artist:41057","relations":{"aliases":null,"groups":null,"members":[{"active":true,"id":1714445,"name":"Rachel de Rougemont"},{"active":true,"id":5318529,"name":"Elana Cager"}],"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/41057-LTrimm","type":"artist","urls":["https://en.wikipedia.org/wiki/L%27Trimm"]}},"/api/discogs/artist/4300679/profile":{"cached":true,"profile":{"id":"4300679","image":"https://i.discogs.com/9in790O__z5LB1znsg8sGMrOOfpNPsJ3bDjN_8LlQjE/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQzMDA2/NzktMTY3Mjk1OTE2/OS0xMTgyLmpwZWc.jpeg","imageThumb":"https://i.discogs.com/d5CVevPXlGfcJwoAAAGlPXaQXGO4sxGw3093YrF_ilQ/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQzMDA2/NzktMTY3Mjk1OTE2/OS0xMTgyLmpwZWc.jpeg","profile":"Electronic music DJ / Producer from Moscow, Russia.","provider":"discogs","ref":"discogs:artist:4300679","relations":{"aliases":null,"groups":null,"members":null,"namevariations":["A Fruit","A. Fruit"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/4300679-AFruit","type":"artist","urls":["https://soundcloud.com/annafruit","https://www.facebook.com/afruitmusic","https://twitter.com/afruitmusic","https://www.instagram.com/fruitbass"]}},"/api/discogs/label/1081881/profile":{"cached":true,"profile":{"id":"1081881","image":"https://i.discogs.com/LLLoAnVburlHMLwdSv_DcicHBYsFHRGm6UxWqwZhIpo/rs:fit/g:sm/q:90/h:500/w:500/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/Y