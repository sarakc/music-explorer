.discogs.com/artist/2150668-Ital-3","type":"artist","urls":[]}},"/api/discogs/artist/2282520/profile":{"cached":true,"profile":{"id":"2282520","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:artist:2282520","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/2282520-The-Poly-Tones","type":"artist","urls":[]}},"/api/discogs/artist/3771823/profile":{"cached":true,"profile":{"id":"3771823","image":"https://i.discogs.com/ScmX7eo1EzRvyDZQKAIQD_eaSXfZnyAfvZy7QDoyy4s/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTM3NzE4/MjMtMTU5NTE2Nzc2/My0zMzgzLmpwZWc.jpeg","imageThumb":"https://i.discogs.com/OIr4379KI8zkh4Nfp0zUwnkTNosv1r6wuPaCBtwcaVQ/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTM3NzE4/MjMtMTU5NTE2Nzc2/My0zMzgzLmpwZWc.jpeg","profile":"Nigerian born future soul artist, singer, songwriter, performer.\r\n\r\nDespite his frosty surname, Wayne Snow encapsulates the word “warmth” in every dimension of his being, both personally and creatively. Taking early inspiration from legends such as Fela Kuti and King Sunny Ade, he has united a global audience from his new home in Berlin, developing a contemporary take on the sun kissed, soulful vibes of his homeland Nigeria. You can feel this warmth blooming in abundance through every song and performance.\r\n\r\nWayne began to experiment with instruments at a very young age after being given a synthesiser by his mother. His first musical breakthrough came in the form of the \"Red Runner\" EP, released on Tartelet Records in 2014. \r\n\r\nWorking with the widely praised producer Max Graef, the pair wrote both “Under the Moon” and “Red Runner”, which put him firmly on the map of the emerging future soul / jazz scene at the time. Shortly after they dropped the stunning “Rosie” EP as well as the highlight of Max’s album “Running”. These influential first productions led up to the release of his his debut LP “Freedom TV\" which was loudly applauded by the music press with glowing reviews from Clash, Mojo, The Fader, VICE,  Boiler Room, Vinyl Factory and championed heavily by influential tastemakers like Gilles Peterson. \r\n\r\nWayne is also responsible for the “Nightbirds” project which he joined together with globetrotting superstar FKJ and regular collaborator Darius (with whom he wrote the stunning “Helios” and “Lost In A Moment” for France’s Roche Musique). You can find his sublime vocal performances on productions with artists like Folamour, Neue Graffik, Noah Slee and the Circle Of Live collective, or via imprints like Brownswood, Dekmantel, Rhythm Section. He was recently shortlisted by both Crack and Clash magazines as the next artist to breakthrough, something soon to be validated by a stellar, new album in the pipeline.","provider":"discogs","ref":"discogs:artist:3771823","relations":{"aliases":null,"groups":null,"members":null,"namevariations":["W. Snow"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/3771823-Wayne-Snow","type":"artist","urls":["https://www.wayne-snow.com","http://eepurl.com/g80qRf","https://waynesnow.bandcamp.com","https://open.spotify.com/album/3b0zttuWwba0UCL1tluQLm","https://itunes.apple.com/us/artist/wayne-snow/990228043","https://www.youtube.com/channel/UC0RZIAhcVSxknV-1qOp6xXQ","","https://www.instagram.com/waynesnowmusic/","https://www.facebook.com/waynesnowmusic/","https://soundcloud.com/waynesnow","https://twitter.com/waynesnowmusic"]}},"/api/discogs/artist/5174746/profile":{"cached":true,"profile":{"id":"5174746","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:artist:5174746","relations":{"aliases":null,"groups":[{"active":true,"id":10852231,"name":"Do Hits"}],"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/5174746-Jason-Hou","type":"artist","urls":[]}},"/api/discogs/artist/7062917/profile":{"cached":true,"profile":{"id":"7062917","image":"https://i.discogs.com/wrJAVBA9mqKwQwCPKd7SCq8NIsFaqcP5iDI0rB0TZVM/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTcwNjI5/MTctMTc1NDUxNDI0/OS0zODcyLnBuZw.jpeg","imageThumb":"https://i.discogs.com/vrDDYMAyHxVpjSlKepBPTOj_nc_2Yx8wZ5-xVG05ozQ/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTcwNjI5/MTctMTc1NDUxNDI0/OS0zODcyLnBuZw.jpeg","profile":"Avery Marcel Joshua Jones (born October 16, 1992), known by his stage name Kota the Friend, is an American rapper, singer, songwriter, and record producer, born and raised in Brooklyn, New York. (Billboard)","provider":"discogs","ref":"discogs:artist:7062917","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/7062917-Kota-The-Friend","type":"artist","urls":["https://www.facebook.com/Kotathefriend/","http://kotathefriend.com/","https://twitter.com/KotaTheFriend?ref_src=twsrc%5Egoogle%7Ctwcamp%5Eserp%7Ctwgr%5Eauthor","https://www.instagram.com/kotathefriend/?hl=en","https://www.youtube.com/@kotathefriend7029"]}},"/api/discogs/artist/727655/profile":{"cached":true,"profile":{"id":"727655","image":"https://i.discogs.com/lY4MzO2X53SazG5DEM0JoaUOz_wehaJadZD-3dkS3c8/rs:fit/g:sm/q:90/h:600/w:480/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTcyNzY1/NS0xNTAxMjMzOTg3/LTE3MDYuanBlZw.jpeg","imageThumb":"https://i.discogs.com/Dx9LJ-3nTOPoic_F9ugs46kznmln03E21wHzmoN4kcg/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTcyNzY1/NS0xNTAxMjMzOTg3/LTE3MDYuanBlZw.jpeg","profile":"Somali-Canadian hip hop artist, born 16 April 1978 in Mogadishu, Somalia. When the civil war in Somalia reached the capital Mogadishu, his parents emigrated with their 13 year old son to Harlem, New York City, before moving to Canada, to the Toronto (Etobicoke) neighbourhood Jamestown in Rexdale, joining a small Somali-Canadian community, from where he started his musical career. His aunt [a=Magool] is revered as being one of Somalia's most famous singers of all time, while his grandfather Haji Mohamed was a renown poet back in Somalia. K'naan is a Muslim and his name means \"traveler\" in the Somali language.\r\n\r\nK'naan became a friend and associate of Canadian promoter [a=Sol Guy], who helped him secure a speaking engagement before the United Nations High Commissioner for Refugees in 1999, where K'naan performed a spoken word piece criticizing the UN for its failed aid missions to Somalia. One of the audience members, Senegalese singer [a=Youssou N'Dour], was so impressed by the young MC's performance and courage that he invited him to contribute to his 2001 album Building Bridges, a project through which K'naan was able to tour the world.\r\n\r\nThis project led to his work at other UN events, as well as the Montreal Jazz Festival and the Halifax Pop Explosion. It also helped him meet Canadian producer [a=Jarvis Church] and his [url=http://www.discogs.com/label/Track+And+Field]Track & Field[/url] team in 2002, who produced his debut album The Dusty Foot Philosopher, which was released in 2005 to critical acclaim. In 2006, it won the Juno Award for Rap Recording of the Year, and was nominated for the 2006 Polaris Music Prize. It also won the BBC Radio 3 Award for World Music in the newcomer category for 2007. The Dusty Foot Philosopher was re-released and re-packaged as a \"Deluxe Edition\" featuring new mixes and a bonus DVD in the United States (and various international territories) by the emerging media company and record label [l=Interdependent Media] in 2008.\r\n\r\nSince then, K'naan has been on tour promoting his album and working on his follow-up release, \"Troubadour,\" his debut album for new label, [l=A&M Octone Records]. He has also collaborated with artists like [a=Nelly Furtado], [a=Mos Def], [a=Will.i.am], [a=Roots], [a=Dead Prez], and [a=Pharoahe Monch] on tours such as Live 8 and Breedlove Odyssey. He also collaborated with [a=Damian Marley] on the \"Welcome to Jamrock\" touring session.\r\n\r\nK'naan rose to mainstream popularity by participating in the 2008 BET Awards Cypher. This was his first appearance on American television. His second studio album, Troubadour, was released on February 24, 2009 on A&M/Octone Records, distributed through Universal Music Group worldwide. The album's first single, \"ABC's\", was released to radio in late 2008. K'naan has featured in several video games such as Madden NFL 09 with his song ABC's, and FIFA 06 with his song \"Soobax\". The song \"If Rap Gets Jealous\", a rerecording of a track of the same name – with different verses – from The Dusty Foot Philosopher, features Metallica lead guitarist [a=Kirk Hammett]. K'naan was also the first featured artist on X3, a collaborative project between CBC Radio 3, Exclaim! magazine and aux.tv to promote new Canadian music. In July 2010, he performed a cover of U2's \"Stuck in a Moment You Can't Get Out Of\" for iheartradio.\r\n\r\nA remixed version of K'naan's single \"Wavin' Flag\" was chosen as [url=http://www.discogs.com/label/Coca+Cola]Coca-Cola[/url]'s anthem for the 2010 FIFA World Cup also in the commercials in the pre-game, held in South Africa. In December 2009, K'naan performed the song live during the sponsor's FIFA World Cup Trophy Tour, which took him to 86 countries around the world.\r\n","provider":"discogs","ref":"discogs:artist:727655","relations":{"aliases":[{"id":1254507,"name":"Keinan Warsame"}],"groups":null,"members":null,"namevariations":["K Naan","K'NAAN","K'Naan","K*naan","K.Naan","Ka'aan","Keinaan","Knaan"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/727655-Knaan","type":"artist","urls":["https://www.facebook.com/knaan","https://www.imdb.com/name/nm2994694/","http://www.myspace.com/knaanmusic","https://en.wikipedia.org/wiki/K%27naan"]}},"/api/discogs/artist/7779136/profile":{"cached":true,"profile":{"id":"7779136","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:artist:7779136","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/7779136-DJ-Planet-Express","type":"artist","urls":[]}},"/api/discogs/label/171386/profile":{"cached":true,"profile":{"id":"171386","image":"https://i.discogs.com/PTksjTwkRzEYfAqdHauiFIDdjRgJc_R7qrCetVCg-vk/rs:fit/g:sm/q:90/h:223/w:561/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTE3MTM4/Ni0xNjQzMDUxNzk0/LTcwNjYuanBlZw.jpeg","imageThumb":"https://i.discogs.com/723hCPaa1uW1ri20vYEdOUKM7x9BmOLiPVxbMfYcleQ/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTE3MTM4/Ni0xNjQzMDUxNzk0/LTcwNjYuanBlZw.jpeg","profile":"US record label / company from La Crosse, Wisconsin.","provider":"discogs","ref":"discogs:label:171386","relations":{"parentLabel":{"id":94692,"name":"Platinum Disc Corporation"},"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/171386-Platinum-Disc","type":"label","urls":[]}},"/api/discogs/label/1867411/profile":{"cached":true,"profile":{"id":"1867411","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:label:1867411","relations":{"parentLabel":null,"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/1867411-AristaLegacy","type":"label","urls":[]}},"/api/discogs/label/2352820/profile":{"cached":true,"profile":{"id":"2352820","image":"https://i.discogs.com/Pml-XEgVDZ0N1_igG3Qf0Z2RkJwxL8VZX884YsuVGpo/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTIzNTI4/MjAtMTYzMTQwMDM1/Ni0yMTg1LnBuZw.jpeg","imageThumb":"https://i.discogs.com/GM9pAZfkvaxwdCbvYNN0XEpDdtHT3Q-cFVgmumD5p3g/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTIzNTI4/MjAtMTYzMTQwMDM1/Ni0yMTg1LnBuZw.jpeg","profile":"Label from Russia","provider":"discogs","ref":"discogs:label:2352820","relations":{"parentLabel":null,"sublabels":null},"schemaVersion":2,"sourceUrl":"ht