{"/api/discogs/artist/10547812/profile":{"cached":true,"profile":{"id":"10547812","image":"https://i.discogs.com/9y2EOnnw-5GG5H6_XrZzE3okWu_jUb7vq9j4OSpUfW8/rs:fit/g:sm/q:90/h:477/w:507/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTEwNTQ3/ODEyLTE3MDA4MjI0/NDYtMjE4MS5qcGVn.jpeg","imageThumb":"https://i.discogs.com/8CByQSueh4qxnxODcUjjyAPAmudoES4ct62SENTTPLY/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTEwNTQ3/ODEyLTE3MDA4MjI0/NDYtMjE4MS5qcGVn.jpeg","profile":"Spanish electronic artist Pablo Jiménez Codina aka GAZZI (Linares).\r\nBorn in Linars in 1994.","provider":"discogs","ref":"discogs:artist:10547812","relations":{"aliases":null,"groups":null,"members":null,"namevariations":["GAZZI","Pablo Jiménez Codina"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/10547812-Gazzi-4","type":"artist","urls":[]}},"/api/discogs/artist/15258039/profile":{"cached":true,"profile":{"id":"15258039","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:artist:15258039","relations":{"aliases":[{"id":17653023,"name":"furrybooty2004"}],"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/15258039-Palimach","type":"artist","urls":[]}},"/api/discogs/artist/16734340/profile":{"cached":true,"profile":{"id":"16734340","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:artist:16734340","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/16734340-Groove-Parliament","type":"artist","urls":[]}},"/api/discogs/artist/2321154/profile":{"cached":true,"profile":{"id":"2321154","image":"https://i.discogs.com/iHv7EGcKdKEDETIGpVfk4QjSp5XDe6bq0SfIgGt6cgI/rs:fit/g:sm/q:90/h:236/w:232/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTIzMjEx/NTQtMTQ0Mzc1NDE5/Mi0yMzg5LnBuZw.jpeg","imageThumb":"https://i.discogs.com/kf6Veaec2WzsCFLYB6mCmyF993Fvd_aUysMhAr59Gjs/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTIzMjEx/NTQtMTQ0Mzc1NDE5/Mi0yMzg5LnBuZw.jpeg","profile":"Terekke (real name Matt Gardner) is an American electronic music producer and DJ currently based in Amsterdam, Netherlands.","provider":"discogs","ref":"discogs:artist:2321154","relations":{"aliases":[{"id":2321155,"name":"Matt Gardner (3)"},{"id":4155820,"name":"X (101)"}],"groups":null,"members":null,"namevariations":["TEREK","Te Rekke"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/2321154-Terekke","type":"artist","urls":["http://soundcloud.com/terekke","https://terekke.bandcamp.com","https://ra.co/dj/terekke","https://www.instagram.com/_terekke","https://soundcloud.com/terekke"]}},"/api/discogs/artist/50703/profile":{"cached":true,"profile":{"id":"50703","image":"https://i.discogs.com/E0YAL4pXT7sI2AOB2GOcuo9bbbx8Twg0UqXI-UC7fyM/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTUwNzAz/LTE1ODQyNjM5ODUt/ODAyOC5qcGVn.jpeg","imageThumb":"https://i.discogs.com/kAC7g1cu2Au4113VVbKOU9GZO1dm_MqYEKAR_YaIRdM/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTUwNzAz/LTE1ODQyNjM5ODUt/ODAyOC5qcGVn.jpeg","profile":"R'n'B singer, songwriter, producer, label executive.\r\n[b]Note: when appearing with L.A. Reid, please use  [a154765][/b]\r\nBorn 10th April 1959 in Indianapolis, Indiana, USA. Brother of [a=Kevon Edmonds] and [a=Melvin Edmonds], ex-husband to [a=Tracey E. Edmonds] (1992 - 2005). He has written and/or produced over 26 No.1 R&B hits and won 11 Grammy Awards. [a=Bootsy Collins] tagged him ''Babyface'' because of his cute face while he was still a teen.\r\n\r\nHe was a guitarist with [a=Manchild (9)] in the late 1970s and a keyboardist with [a=The Deele] till the late 1980s, a group that included his later partner [a=L.A. Reid] with whom he would build one of the most successful writing and producing duos of r'n'b, [a=L.A. & Babyface]. In 1986 he started his solo career and up to 2014 he had released 10 albums. He was one of the basic figures that created the new jack swing sound, producing [a=Bobby Brown], [a=Karyn White], [a=Pebbles], [a=Paula Abdul] and [a=Sheena Easton] co-founding [l=LaFace Records] in 1989, with the label's early artists [a=TLC], [a=Usher], [a=Toni Braxton] becoming huge stars. He helped forming [a=Az Yet] and in the 1990s he produced [a=Madonna], [a=Whitney Houston], [a=Boyz II Men], [a=Michael Jackson], [a=Eric Clapton] and a long series of others and in the next decades he produced [a=Lil Wayne], [a=Ariana Grande], even [a=Barbra Streisand].","provider":"discogs","ref":"discogs:artist:50703","relations":{"aliases":[{"id":664506,"name":"Kenneth Edmonds"}],"groups":null,"members":null,"namevariations":["\"Baby Face\"","\"Face\"","\"Face'","B.F. (*C.)","Baby","Baby Face","Baby Fase","Baby Fsce","BabyFace","Babyfase","Bady Face","Edomond","FACE","Face","Jaicko","Kenny \"Babyface\" Edmonds","Kenny Edmunds","The Face","xKenny \"Babyface\" Edmonds","ベイビーフェイス","ベイビーフエイス","娃娃臉"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/50703-Babyface","type":"artist","urls":["https://www.babyfacemusic.com/","https://www.facebook.com/Babyface/","https://www.imdb.com/name/nm0004892/","https://instagram.com/babyface","https://myspace.com/babyfaceislandrecords","https://en.wikipedia.org/wiki/Babyface_(musician)","https://twitter.com/KennyEdmonds","https://www.youtube.com/channel/UC5l1M5BAyUNyGiy2fdn9UKA"]}},"/api/discogs/artist/5467/profile":{"cached":true,"profile":{"id":"5467","image":"https://i.discogs.com/f1mXeOukKuOuh7vG1GqIM5f7XDvZ0IUFDjUfyHkTTmY/rs:fit/g:sm/q:90/h:159/w:331/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTU0Njct/MTM4MzU4OTE3MC0x/MzY1LmpwZWc.jpeg","imageThumb":"https://i.discogs.com/FP_nIko-Avhk7wNokRP9Oy7ieeSHlDAOVifAR9-5vBI/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTU0Njct/MTM4MzU4OTE3MC0x/MzY1LmpwZWc.jpeg","profile":"Drum and bass group who began life in the early-1990s as a hardcore dance act. Th