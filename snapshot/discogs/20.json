scogs","ref":"discogs:artist:8170968","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/8170968-Toumba-2","type":"artist","urls":["https://www.instagram.com/toumba__/","https://soundcloud.com/toumbaa"]}},"/api/discogs/label/1170447/profile":{"cached":true,"profile":{"id":"1170447","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:label:1170447","relations":{"parentLabel":null,"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/1170447-Ruffians","type":"label","urls":[]}},"/api/discogs/label/164198/profile":{"cached":true,"profile":{"id":"164198","image":"https://i.discogs.com/M42Fwqv13NN66Is6Fw7bM5Ioxb7Hr1PLCxPCKM8_Tl0/rs:fit/g:sm/q:90/h:168/w:172/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTE2NDE5/OC0xMjUyMjc3MTA0/LmdpZg.jpeg","imageThumb":"https://i.discogs.com/on5xXETafVQubkTYBTGNWdcqmK1tapznveU9yoO7oIA/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTE2NDE5/OC0xMjUyMjc3MTA0/LmdpZg.jpeg","profile":"Record label, previously known as [l135309] before the parent company changed its name from [l168741] to [l768333] on 13 November 2007.\r\n\r\nEarlier releases show this label being linked to [l768333] and more recently being seen on [l480716] releases.\r\n","provider":"discogs","ref":"discogs:label:164198","relations":{"parentLabel":{"id":480716,"name":"Go Entertainment Group Ltd."},"sublabels":[{"id":1306668,"name":"2CD Autograph Collection"},{"id":309622,"name":"Icons (2)"},{"id":930088,"name":"Reflections (8)"},{"id":931563,"name":"Signature Collection (2)"}]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/164198-Go-Entertain","type":"label","urls":[]}},"/api/discogs/label/1894507/profile":{"cached":true,"profile":{"id":"1894507","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:label:1894507","relations":{"parentLabel":null,"sublabels":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/1894507-Therapy-6","type":"label","urls":[]}},"/api/discogs/label/271/profile":{"cached":true,"profile":{"id":"271","image":"https://i.discogs.com/peuj0Vsm8DV343bSWtQCUYvYkgEriIzkJa2fo4zakCg/rs:fit/g:sm/q:90/h:300/w:300/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTI3MS0x/MTY4NzQ0NDA1Lmpw/ZWc.jpeg","imageThumb":"https://i.discogs.com/CNKDuZNiOiwHy4I2aMEIJ7ddha0KlYid0P6WWF0qH7U/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9MLTI3MS0x/MTY4NzQ0NDA1Lmpw/ZWc.jpeg","profile":"NOTE: Catalogue numbers followed the \"RIVET 12xx\" format from 1992-1996. Upon the 100th release, releases switched to the \"RIVET 1xx\" format. With the beginning of Reinforced 2nd Wave in the year 2000, cat#s switched to lowercase from \"rivet 136\" onwards.\r\n\r\nReinforced Records was run by Mark Clair, Gus Lawrence, Dennis McFarlane & Ian Bardouille (aka [a=4 Hero]).\r\nThey first met in college in 1987 while all studying electronic engineering (OND).  Mark and Ian had already formed a sound system from '86 called Solar Zone.While in college they met an electronic wizard who claimed he could build radio transmitters (Gus), so they put their money together to start a pirate radio station.  A determinedly individual approach to the music played ensured that Strong Island Radio soon established a cult following. Enter Dego, one of the best DJs on the station, and the quartet are formed.\r\n\r\nAt Gus' suggestion, they started to produce hip-hop, with some level of success. Mark was convinced that the cru could record and put records out themselves but, by this time, the UK hip hop scene was fading, due in part to the explosion of House Music but also because of frustration at the perceived failings of the UK scene felt by those within it. So in the Autum of 1989, Mark and Gus formed Reinforced Records.\r\n\r\nThe first release on the label was 4 Hero's 'Rising Son' produced by Mark, a rough, hip hop beat using the current House sounds incorporated into the beat. The main loop was from the 'Shaft in Africa' soundtrack, and gave the track a 'jungle' sound . Once the track had been recorded on an old broken down 4 track fostex, the guys put money together and pressed and sold 800 copies. The second recording was a track called 'Mr Kirks Nightmare' produced by Mark and Gus. Mr Kirk sold more than 24,000 copies and the rest, as they say, is history. [a=Goldie] later joined the label as A&R and sleeve designer.\r\n\r\nThrough the whole of the 1990's, Reinforced earned, and deserved, a reputation as the most important and innovative Drum n' Bass label in the world. Their limited-edition 'Enforcers' picture discs are now worth more than gold! Maybe a dozen of the scene's most important producers (including Goldie) kick started their music careers with Reinforced...the influence of this label reaches far and wide and now 20 years later... maybe even further.\r\n\r\nIt is distributed by LOAD Media\r\n","provider":"discogs","ref":"discogs:label:271","relations":{"parentLabel":null,"sublabels":[{"id":833,"name":"2000 Black"},{"id":348665,"name":"Enforcers"},{"id":1719859,"name":"Haters Inc. Records"},{"id":2851,"name":"Partners Inc."},{"id":1506,"name":"Reflective (2)"},{"id":553954,"name":"Reinforced DJ Classic"},{"id":290992,"name":"Reinforced Music"},{"id":300106,"name":"Reinforced Studios"},{"id":17517,"name":"Tom & Jerry"}]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/label/271-Reinforced-Records","type":"label","urls":["http://www.reinforcedrecords.co.uk","https://reinforced-music.bandcamp.com/","http://reinforced25.com","http://www.facebook.com/reinforced","http://www.instagram.com/chapterroad","http://twitter.com/reinforced","http://www.youtube.com/user/reinforcedtv","http://www.youtube.com/user/ReinforcedRecords","http://myspace.com/reinforcedrecords"]}},"/api/discogs/label/3077/profile":{"cached":true,"profile":{"id":"3077","image":"https://i.discogs.com/BFAijab60Au4loZ-obJ1CyHRWLLvq_f