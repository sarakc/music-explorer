cogs.com/xq_YYaG3kPg0lVkhyYIOOpVWxUWZEUYiCucfxvYlpQo/rs:fit/g:sm/q:90/h:600/w:482/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTUwNTE0/LTE2OTg2MDczOTct/MjgzNi5qcGVn.jpeg","imageThumb":"https://i.discogs.com/JIqhA-rlPEOkw4gF-gquavZtbmT0Tx4JQGWCcTgRdmI/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTUwNTE0/LTE2OTg2MDczOTct/MjgzNi5qcGVn.jpeg","profile":"Lawrence Parker (born August 20, 1965 in The Bronx, NY, United States), better known by his stage name KRS-One, is an American MC and producer. His name is an acronym for \"Knowledge Reigns Supreme Over Nearly Everyone.\" \n\nOriginally a graffiti artist, he designed the logo for [l=B-Boy Records] who released his first recordings with group [a=Boogie Down Productions]. Over his career, he has been known by pseudonyms including \"Kris Parker,\" \"The Blastmaster,\" \"The Teacha,\" and \"The Philosopher.\" At the 2008 BET Awards, KRS-One was the recipient of the Lifetime Achievement Award for his work and effort toward the Stop the Violence Movement, and his position as a pioneer of Hip-Hop music and culture.\n\nHe is married to [a=G. Simone].","provider":"discogs","ref":"discogs:artist:50514","relations":{"aliases":[{"id":623718,"name":"Big Joe Krash"},{"id":823424,"name":"Lawrence Krisna Parker"},{"id":5710147,"name":"Blastmaster (2)"},{"id":5710165,"name":"The Teacha"}],"groups":null,"members":null,"namevariations":["Blackmaster KRS-One","Blast Master KRS-One","Blastmaster K.R.S. One","Blastmaster KRS 1","Blastmaster KRS One","Blastmaster KRS-1","Blastmaster KRS-ONE","Blastmaster KRS-One","Crusoe 1","F KRS One","K.R.S.","K.R.S. 1","K.R.S. One","K.R.S.-1","KRS","KRS  1","KRS - One","KRS -1","KRS 1","KRS 1 Blastmaster","KRS ONE","KRS One","KRS One*","KRS | One","KRS-1","KRS-ONE","KRS-One Metaphysician","KRS-ワン","KRS.1","KRS1","KRSI","KRSONE","KRSOne","KRSone","KRS|One","Krs","Krs 1","Krs One","Krs-1","Krs-One","Krs.1","Krs1","KrsOne","Krsone","L. Parker","RRS-1","The Mighty KRS-One"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/50514-KRS-One","type":"artist","urls":["http://www.krs-one.com","http://krsone.bandcamp.com","http://www.facebook.com/KRS-One-153571167636","http://www.facebook.com/Lawrence.Parker.The.Teacher.23","http://www.instagram.com/teacha_krsone","http://twitter.com/iamkrsone","http://en.wikipedia.org/wiki/KRS-One","http://www.youtube.com/user/KRSOneVEVO"]}},"/api/discogs/artist/61948/profile":{"cached":true,"profile":{"id":"61948","image":"https://i.discogs.com/Ke3WdhLQJr4WnxXZyECwlLViFBipFbZq0z62UbSkytg/rs:fit/g:sm/q:90/h:411/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTYxOTQ4/LTE1MTc2NTk5NDgt/MTYwNC5qcGVn.jpeg","imageThumb":"https://i.discogs.com/DbV-9raXJo8U_SgADy_Ao5RbUz98GjqT5tww1HkgyUI/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTYxOTQ4/LTE1MTc2NTk5NDgt/MTYwNC5qcGVn.jpeg","profile":"Javelin consists of two cousins, Tom Van Buskirk and George Langford. They started making music together in Providence, RI in 2004, although their earliest collaborative tapes date back to a bunk bedroom near the sea shore. They now live in New York.\r\n\r\nIn performance, Javelin will use colorfully painted boomboxes that form large speaker totems (“boombaatas”) which can hang from the ceiling or stack up on the floor like pyramids. The signal from the show is broadcast via FM transmitter, thereby fostering audience participation (B.Y.O.Boombox) or fueling battery-powered, mobile parties.\r\n\r\nThe duo has played venues as diverse as the children’s branch of the Olneyville Public Library (RI), to the Museum of Modern Art (NY), both of which happened in the same week.\r\n\r\nWhen not performing, Javelin is busy producing. Together they have amassed a vast catalogue of music, varying in its aesthetic range. Songs resemble the record collection from whence they spring, if not literally as when sampling, then figuratively as when past forms are cited and re-contextualized. Sounds range from broken dance jams to relaxed instrumental cut-ups, created with love on their MPCs. Long forgotten samples are chopped and re-assembled with drums, wooden recorders, old keyboards, handmade thumb pianos or whatever instruments are readily at hand. The result is a kind of mix tape fantasy (residing in the mythical “dollar bins of the future”), where R & B impresarios, amateur booty bass producers and Andean flautists hold equal sway.","provider":"discogs","ref":"discogs:artist:61948","relations":{"aliases":null,"groups":null,"members":[{"active":true,"id":818065,"name":"George Langford"},{"active":true,"id":818066,"name":"Tom Van Buskirk"}],"namevariations":["Javelinas"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/61948-Javelin","type":"artist","urls":["http://dollarbinsofthefuture.com/","http://www.myspace.com/hotjamzofjavelin"]}},"/api/discogs/artist/9325228/profile":{"cached":true,"profile":{"id":"9325228","image":"https://i.discogs.com/7yPjfmFSE1IsA8os3YMgba5GjbD1JvpGxWGbvhWboMw/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTkzMjUy/MjgtMTY5MTc2NDcy/NC04OTgzLmpwZWc.jpeg","imageThumb":"https://i.discogs.com/eo4al6pYZlCfUnxXdGwWVIP6tJA3KSsyOAgIx2scLmI/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTkzMjUy/MjgtMTY5MTc2NDcy/NC04OTgzLmpwZWc.jpeg","profile":"","provider":"discogs","ref":"discogs:artist:9325228","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/9325228-K-65","type":"artist","urls":[]}},"/api/discogs/artist/94090/profile":{"cached":true,"profile":{"id":"94090","image":"https://i.discogs.com/EmOwcwaF5dczyRdE1zFucafPPRWE5YUIX3dYu6TvWGg/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTk0MDkw/LTE0MDM0NzM3OTgt/NzAxNi5qcGVn.jpeg","imageThumb":"https://i.discogs.com/4qRzmIVMnAl7CwdbZATc0IYs9BywI1P8U6aHG9rmDKI/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTk0MDkw/LTE0MDM0Nz