{"/api/discogs/artist/2643553/profile":{"cached":true,"profile":{"id":"2643553","image":"https://i.discogs.com/Ik-oj9ryXAbsxrXjSL87fhP-QYzvy3KHc2U9ZhX02A4/rs:fit/g:sm/q:90/h:328/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTI2NDM1/NTMtMTc3MDM2MTY5/OC05MDQ5LmpwZWc.jpeg","imageThumb":"https://i.discogs.com/tIwb7--QH8muhGTq6tKjrNdEf3fv_S1qJG5nGd5K_k0/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTI2NDM1/NTMtMTc3MDM2MTY5/OC05MDQ5LmpwZWc.jpeg","profile":"German electronic music producer, evolving in early 2018 from Deep / Tech House into 90's influenced Techno.\r\nFounded [l=Zuckerton Records] in 2011 and [l=Outworld] in 2019.","provider":"discogs","ref":"discogs:artist:2643553","relations":{"aliases":[{"id":3122725,"name":"Michael Korb (2)"}],"groups":null,"members":null,"namevariations":["KlangKünstler","Klangkünstler"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/2643553-Klangkuenstler","type":"artist","urls":["http://klangkuenstler.com/","http://www.facebook.com/klangkuenstler","http://instagram.com/klangkuenstler","http://soundcloud.com/klangkuenstler","http://www.residentadvisor.net/dj/klangkuenstler"]}},"/api/discogs/artist/4480/profile":{"cached":true,"profile":{"id":"4480","image":"https://i.discogs.com/QFpPLuR7Tp_eLWGegxqojKyRM-Rij-NURVAnkVnMHTw/rs:fit/g:sm/q:90/h:416/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQ0ODAt/MTYwMzQzNzk1Ny03/MjcxLmpwZWc.jpeg","imageThumb":"https://i.discogs.com/yoorQ6ZoDwaSK7yC-VMkMH8kX4oxTyKAQNffDUBHnlQ/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQ0ODAt/MTYwMzQzNzk1Ny03/MjcxLmpwZWc.jpeg","profile":"Collaborative British music production group from Bristol, England.\n\nThe band currently consists of Robert Del Naja, Tricky, and Daddy G. The original lineup also included Andrew Vowles. The group name is taken from a slogan sprayed by New York graffiti artist 'Brim', who sprayed 'Massive Attack' underneath a 'piece' in Bristol, UK in 1985. 'Brim', along with 'Balogun' and 'Bio' were part of the TATS CRU from NYC who sprayed a 'piece' each together at the Malcolm X Centre, St. Paul's in Bristol.Robert Del Naja, who was an upcoming graffiti artist at the time, with the tag 3-D, has stated that he/they had adopted the slogan initially as a name for a record label, and then later took it on as a band name. During the 1991 Gulf War the group name was shown on some releases as 'Massive' in order to maintain airplay after pressure from the British Government on radio programmers.\nIn September 1996, the band launched its own label Melankolic.","provider":"discogs","ref":"discogs:artist:4480","relations":{"aliases":null,"groups":null,"members":[{"active":true,"id":151718,"name":"Robert Del Naja"},{"active":true,"id":457994,"name":"Grant Marshall"},{"active":false,"id":636544,"name":"Andrew Vowles"},{"active":true,"id":744490,"name":"Adrian Thaws"}],"namevariations":["M. Attack","Massiv Attack","Massive","Massive Attac","MassiveAttack","Massived Attack","The Massive Attack","マッシヴ・アタック","強烈衝擊"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/4480-Massive-Attack","type":"artist","urls":[]}},"/api/discogs/artist/467747/profile":{"cached":true,"profile":{"id":"467747","image":"https://i.discogs.com/54i3Xkf1dJBHvQECLLC4zWuCJYXAj_662DPyYXowcrc/rs:fit/g:sm/q:90/h:243/w:300/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQ2Nzc0/Ny0xMTY3ODA4NzA5/LmpwZWc.jpeg","imageThumb":"https://i.discogs.com/SfMxD7o6TSchbDthP4FtQ6mqSCU8eEhzmJFCwF1XKg4/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQ2Nzc0/Ny0xMTY3ODA4NzA5/LmpwZWc.jpeg","profile":"Indie pop group from Omaha, Nebraska, USA, active from 2001 - 2013.\r\n\r\nDerek Pressnall - vocals, guitar \r\nKianna Alarid - vocals, shakers, tambourine, recorder, bass \r\nNeely Jenkins - vocals, shakers, bells, bass \r\nJamie Williams - tap dancer \r\nNick White - keyboard \r\n","provider":"discogs","ref":"discogs:artist:467747","relations":{"aliases":null,"groups"