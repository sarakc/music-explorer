scogs.com/KmcCRQyvabhxpr4njqN4O0grez7V5V2SLnpbqhEp2wk/rs:fit/g:sm/q:90/h:312/w:208/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE1ODA4/NTctMTQwMjIxODk3/My00NTU2LmpwZWc.jpeg","imageThumb":"https://i.discogs.com/1SdmfHaWHgjC6KetMHFyyaLB56YDvCW6IbXdAgZZNe8/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE1ODA4/NTctMTQwMjIxODk3/My00NTU2LmpwZWc.jpeg","profile":"Bassist of the Spanish punk rock band Safety Pins from 1997 to 2001.","provider":"discogs","ref":"discogs:artist:1580857","relations":{"aliases":null,"groups":[{"active":false,"id":642631,"name":"Safety Pins"},{"active":true,"id":1385955,"name":"The Bite (2)"},{"active":true,"id":4598023,"name":"The Meetup"}],"members":null,"namevariations":["Martini"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/1580857-Martini-4","type":"artist","urls":[]}},"/api/discogs/artist/181022/profile":{"cached":true,"profile":{"id":"181022","image":"https://i.discogs.com/kelTQuTsPI5lM8LDuagUemeIyWXTsDtglNuwksZJiZ0/rs:fit/g:sm/q:90/h:543/w:433/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE4MTAy/Mi0xNTExNDYyMzI0/LTY1NjcuanBlZw.jpeg","imageThumb":"https://i.discogs.com/Hv98PMfp6LrRFGUjlmZJn0Ickd4Q7wbXveYRyy18Axw/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTE4MTAy/Mi0xNTExNDYyMzI0/LTY1NjcuanBlZw.jpeg","profile":"William Leonard Roberts II (born January 28, 1976), known professionally by his stage name Rick Ross, is an American rapper and entrepreneur.\r\n\r\nIn 2009, Ross founded the record label Maybach Music Group, on which he released his studio albums Deeper Than Rap (2009), Teflon Don (2010), God Forgives, I Don't (2012), Mastermind, Hood Billionaire (2014), Black Market (2015), and Rather You Than Me (2017). Ross was also the first artist signed to Diddy's management company Ciroc Entertainment. In early 2012, MTV named Ross as the Hottest MC in the Game.\r\n\r\nWilliam Leonard Roberts II was born in Clarksdale, Mississippi, and raised in Carol City, Florida. After graduating from Miami Carol City Senior High School, he attended the historically black college Albany State University on a football scholarship. Roberts worked as a correctional officer for 18 months from December 1995, until his resignation in June 1997.\r\n\r\nIn his early years at Suave House Records, Roberts initially made his debut under the pseudonym Teflon Da Don. He made his recording debut on the song \"Ain't Shhh to Discuss\" on Erick Sermon's lone album for DreamWorks, Def Squad Presents Erick Onasis. In the mid-2000s, he changed his name to Rick Ross. He derived his stage name from the former drug kingpin \"Freeway\" Rick Ross, to whom he has no connection\r\n\r\nAfter being signed to Suave House Records, former label for rap duo 8Ball & MJG, he eventually signed a deal with Slip-n-Slide Records, which has been under the Def Jam label since 2006. While signed to Slip-n-Slide, Roberts toured with fellow rapper Trick Daddy and made guest performances on other Slip-n-Slide albums.","provider":"discogs","ref":"discogs:artist:181022","relations":{"aliases":[{"id":992746,"name":"William Roberts (2)"},{"id":15498780,"name":"Teflon Da Don (2)"}],"groups":null,"members":null,"namevariations":["@mastermind","R. Ross","Ric Ross","Rick Ro$$","RickRo$$","RickRoss","Rickross","Ricky Rozay","Rock Ross","Ross","The Boss Rick Ro$$","The Boss Rick Ross","The Boss Ricky Rozay","The Miami Mayor Rick Ross"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/181022-Rick-Ross","type":"artist","urls":["https://www.facebook.com/rickross","https://www.instagram.com/richforever","http://www.twitter.com/rickyrozay","https://en.wikipedia.org/wiki/Rick_Ross"]}},"/api/discogs/artist/264873/profile":{"cached":true,"profile":{"id":"264873","image":"https://i.discogs.com/FFaEvvjFyoSkYtWEK7NpiaaKw6iOQtSwNXD-SB6fn5s/rs:fit/g:sm/q:90/h:587/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTI2NDg3/My0xNjIzOTE3NDY3/LTEyNjIuanBlZw.jpeg","imageThumb":"https://i.discogs.com/7ymZCPIOmw1hY3ffYy5zNuLDxNMltvPwY0G44wMg5sU/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTI2NDg3/My0xNjIzOTE3NDY3/LTEyNjIuanBlZw.jpeg","profile":"Singer, songwriter and rapper born 1 May 2000 in Benin City, Edo State, Nigeria.","provider":"discogs","ref":"discogs:artist:264873","relations":{"aliases":[{"id":9516334,"name":"Divine Ikubor"}],"groups":null,"members":null,"namevariations":["Réma"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/264873-Rema","type":"artist","urls":["https://www.instagram.com/heisrema","https://twitter.com/heisrema"]}},"/api/discogs/artist/30721/profile":{"cached":true,"profile":{"id":"30721","image":"https://i.discogs.com/qXngxg5j7DB-6e44VE4B0KNlONd9wf9hnMLMewVTwnw/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTMwNzIx/LTE2MDc1MjA4MzEt/ODk1Mi5wbmc.jpeg","imageThumb":"https://i.discogs.com/2sZvLVuTdYX9vdzs6RFvwHV2dgtmdkQ634il8mZnPH8/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTMwNzIx/LTE2MDc1MjA4MzEt/ODk1Mi5wbmc.jpeg","profile":"American jazz flutist, tenor saxophonist, and clarinetist (soprano and bass). He branched out to latin jazz, reggae and disco, to name some of the styles he explored. Mann also established [l=Embryo Records] (1969-1977) and [l=Kokopelli Records] (mid. '90s).\n\nBorn April 16, 1930 in Brooklyn, New York, died July 01, 2003 in Pecos, New Mexico\n\nFirst began playing professionally at the age of fifteen. After serving in the U.S. Army overseas in the early '50s, Mann recorded for Bethlehem Records and was among the group of reed players to first utilize the flute as a main voice in jazz. During this time he still played multiple instruments in the bop/cool jazz idioms but explored what became known as world music early on. He eventually became among first American jazz artists to record in the bossa nova style and in Brazil during the early 1960s, abandoning other reed instruments to focus on flutes.\n\nDuring the late 1960s, when Miles Davis was fusing rock with jazz, he began fusing Southern rock and soul with jazz which led to the hit album Memphis Underground.\n\nHerbie began getting involved with the newly emerging disco scene when he covered LTG Exchange's \"Waterbed\" which appeared on the album of the same name. It's a very funky instrumental with a great bassline. On this album he also covered \"Hijack\" by Barrabas. This became popular in the early disco scene in the UK and was one of the very first 12\" promos ever pressed in Europe.\n\nAnother disco recording was his cover of Celi Bee's \"Superman\" theme which peaked at #26 on the US Billboard charts. For this album, called \"Super Mann,\" Herbie worked with New York disco producer Patrick Adams and together they wrote the jazz-funk classic \"Etagui\".\n\nFather of jazz drummer & arranger [a2046927].","provider":"discogs","ref":"discogs:artist:30721","relations":{"aliases":[{"id":2021981,"name":"Herbert Solomon"}],"groups":[{"active":true,"id":335207,"name":"Marty Paich Orchestra"},{"active":true,"id":375436,"name":"Herbie Mann Quartet"},{"active":true,"id":940203,"name":"Herbie Mann's Californians"},{"active":true,"id":1272344,"name":"The Herbie Mann Nonet"},{"active":true,"id":1320581,"name":"The Herbie Mann Afro-Jazz Sextet + Four Trumpets"},{"active":true,"id":1491260,"name":"The Family Of Mann"},{"active":true,"id":2462139,"name":"The Quincy Jones Big Band"},{"active":true,"id":3418365,"name":"The Herbie Mann Sextet"},{"active":true,"id":4240081,"name":"Herbie Mann Quintet"},{"active":true,"id":4759939,"name":"Herbie Mann And His Orchestra"},{"active":true,"id":5602200,"name":"The Herbie Mann-Sam Most Quintet"},{"active":true,"id":6130236,"name":"Herbie Mann And The Carnival Band"},{"active":true,"id":6582945,"name":"Four Flutes"}],"members":null,"namevariations":["E. Mann","H, Mann","H. Mann","H.Mann","Herb Mann","Herbert Jay Mann","Herbert Mann","Herbie","Herbie Man","Herbie Mann & His All Stars","Herbie Mann & His Group",