=Soulfuric Recordings] (A&R: [a=Seamus Haji])\r\n[l=Slip'N'Slide Records] (label: [l=Slip 'N' Slide])\r\n[l=Yoruba Records]\r\n[l=Fourth Floor Records] aka [l=4th Floor Records]\r\n[l=K4B Records]\r\n[l=Movin' Records]\r\n[l=Sub-Urban]\r\n\r\n[u]Former sublabels[/u]\r\n[l=ITH Records]\r\n[l=Soul Heaven Records]\r\n[l=Bargrooves]\r\n[l=Cyphon]\r\n[l=Fluential Records] (label: [l=Fluential])\r\n[l=M (4)]\r\n[l=Spectrum Records]\r\n[l=The Sound Of Defected]\r\n[l=Code Red Recordings]\r\n[l=Strictly Rhythm]\r\n[l=Sondela Recordings]\r\n\r\n[u]Series[/u]\r\n[l=House Masters]\r\n[l=Most Rated]\r\n[l=In The House]\r\n[l=For The Love Of House]\r\n[l=Isolation Nation]\r\n[l=Sampler EP]\r\n[l=Sessions (5)] (with [l=Ministry Of Sound])\r\n[l=Together (3)]\r\n[l=Connected (4)]\r\n[l=Deep Down & Defected]\r\n[l=Defected Accapellas]\r\n[l=Defected Clubland Adventures]\r\n[l=Defected D-Fused]\r\n[l=Defected D-Fused & Digital]\r\n[l=Defected In The House]\r\n[l=Defected Presents]","provider":"discogs","ref":"discogs:label:98","relations":{"parentLabel":{"id":272745,"name":"Defected Records Ltd."},"sublabels":[{"id":1283765,"name":"4 To The Floor Records"},{"id":3830,"name":"4th Floor Records"},{"id":113724,"name":"Bargrooves"},{"id":146395,"name":"Big Love Music"},{"id":281782,"name":"Classic Music Company"},{"id":728758,"name":"Connected (4)"},{"id":50862,"name":"Cyphon"},{"id":995016,"name":"D-Vine Sounds"},{"id":1977915,"name":"D4 D4NCE"},{"id":3674980,"name":"Deep Down & Defected"},{"id":656850,"name":"Defected Accapellas"},{"id":1063405,"name":"Defected Clubland Adventures"},{"id":1928524,"name":"Defected D-fused"},{"id":1912560,"name":"Defected D-fused & Digital"},{"id":841559,"name":"Defected In The House"},{"id":782910,"name":"Defected Presents"},{"id":555650,"name":"DFTD"},{"id":2151664,"name":"Faith (18)"},{"id":8721,"name":"Faya Combo"},{"id":339990,"name":"Fluential Records"},{"id":3105820,"name":"For The Love Of House"},{"id":903,"name":"Fourth Floor Records"},{"id":12