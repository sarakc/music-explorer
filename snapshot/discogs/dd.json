afuBanton507"]}},"/api/discogs/artist/257025/profile":{"cached":true,"profile":{"id":"257025","image":"https://i.discogs.com/N9yWtTrlA8Y7cz1a08encGCWE-76GkCExHM6p5qKJoY/rs:fit/g:sm/q:90/h:570/w:520/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTI1NzAy/NS0xNzUzNzIyMjA2/LTE1NTQuanBlZw.jpeg","imageThumb":"https://i.discogs.com/o0HwN-Z1_svDy0hokxTWlpgcqyKT5l3qpgMzMiQ8sMY/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTI1NzAy/NS0xNzUzNzIyMjA2/LTE1NTQuanBlZw.jpeg","profile":"American jazz guitarist, born 4 December 1930 in Buffalo, New York, USA, died 10 December 2013 in New York City, New York, USA. Married to [a=Jane Hall (3)].\r\n\r\nFor the Nashville, TN, country arranger, see [a=Jim Hall (9)].","provider":"discogs","ref":"discogs:artist:257025","relations":{"aliases":null,"groups":[{"active":true,"id":267668,"name":"Paul Smith Quartet"},{"active":true,"id":269599,"name":"The Dukes Of Dixieland"},{"active":true,"id":284746,"name":"Woody Herman And His Orchestra"},{"active":false,"id":330153,"name":"The Jimmy Giuffre Trio"},{"active":false,"id":330155,"name":"The Chico Hamilton Quintet"},{"active":true,"id":345649,"name":"Jim Hall / Ron Carter Duo"},{"active":false,"id":543838,"name":"Bob Brookmeyer Quintet"},{"active":false,"id":626300,"name":"The Chico Hamilton Trio"},{"active":true,"id":846687,"name":"Gerry Mulligan & The Concert Jazz Band"},{"active":false,"id":857128,"name":"Sonny Rollins & Co."},{"active":true,"id":864402,"name":"Jim Hall Trio"},{"active":true,"id":979822,"name":"The Gary McFarland Orchestra"},{"active":false,"id":1013303,"name":"Gerry Mulligan And His Sextet"},{"active":false,"id":1063312,"name":"Art Farmer Quartet"},{"active":true,"id":1114062,"name":"Woody Herman And The Swingin' Herd"},{"active":true,"id":1685319,"name":"Bill Perkins Quintet"},{"active":true,"id":1696064,"name":"Hampton Hawes Quartet"},{"active":false,"id":1880868,"name":"Gary Burton & Friends"},{"active":false,"id":1904602,"name":"The Jimmy Giuffre 4"},