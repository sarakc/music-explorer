:["https://uprootandy.bandcamp.com/","http://soundcloud.com/uprootandy","http://www.facebook.com/uprootandy","http://twitter.com/uprootandy"]}},"/api/discogs/artist/15762354/profile":{"cached":true,"profile":{"id":"15762354","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:artist:15762354","relations":{"aliases":null,"groups":null,"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/15762354-La-Perversa","type":"artist","urls":[]}},"/api/discogs/artist/2006754/profile":{"cached":true,"profile":{"id":"2006754","image":"https://i.discogs.com/DtKpCkApi4hh93VPk0iF-xqfXSq3JyCf4oJuUb5kutY/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTIwMDY3/NTQtMTQ3ODE2MjY4/MS05NTU2LmpwZWc.jpeg","imageThumb":"https://i.discogs.com/K6ScAo49J64LCFj_0CSs1BxOL8G2OxA1mNEyOjz5dVQ/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTIwMDY3/NTQtMTQ3ODE2MjY4/MS05NTU2LmpwZWc.jpeg","profile":"Chicago footwork producer DJ Taye made his name as one of the youngest artists affiliated with the Teklife crew, which he joined in 2010. Born in 1994, he began making hip-hop beats and rapping at age 11, and was introduced to the sounds of DJ Rashad and DJ Spinn in 2007. Entranced by the head-spinning beats, booming bass, and frantically cut-up samples, he began producing his own tracks in that style, and eventually racked up several digital releases and mix sessions. Tracks by Taye appeared on Hyperdub's 2014 compilations Hyperdub 10.1 and Next Life, and the label signed him, releasing his debut vinyl EP, Break It Down, the following year. His second EP for the label, Move Out, appeared in 2016. ~ Paul Simpson","provider":"discogs","ref":"discogs:artist:2006754","relations":{"aliases":[{"id":6100859,"name":"Dante Sanders"}],"groups":[{"active":true,"id":4821006,"name":"Teklife"}],"members":null,"namevariations":["Deejay Taye","Taye"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/2006754-DJ-Taye","type":"artist","urls":["http://djtaye.bandcamp.com","http://soundcloud.com/djtaye","http://tekliferecords.com"]}},"/api/discogs/artist/2284178/profile":{"cached":true,"profile":{"id":"2284178","image":"https://i.discogs.com/C0k2SbPITj6fRZaVTUwn0VvmnZQ2bY6BJoYsHdzrWaA/rs:fit/g:sm/q:90/h:600/w:480/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTIyODQx/NzgtMTQ1MDMzNDQ4/OC0xNTQxLmpwZWc.jpeg","imageThumb":"https://i.discogs.com/ptgJOFj11-s_C5Q4LMhR7I_v4Na4eUHn86-yw-SjnE4/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTIyODQx/NzgtMTQ1MDMzNDQ4/OC0xNTQxLmpwZWc.jpeg","profile":"Beijing, China\r\nFuture music from downtown Beijing.","provider":"discogs","ref":"discogs:artist:2284178","relations":{"aliases":null,"groups":[{"active":true,"id":10852231,"name":"Do Hits"}],"members":null,"namevariations":null},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/2284178-Howie-Lee","type":"artist","urls":["http://howielee.bandcamp.com/","https://www.facebook.com/howieleeofficial?ref=hl","http://www.soundcloud.com/howielee"]}},"/api/discogs/artist/2519144/profile":{"cached":true,"profile":{"id":"2519144","image":"https://i.discogs.com/ilfkJ-A-OxQVIy2XBUmF77ckCs3EC0Ziqop7x-7cX5Q/rs:fit/g:sm/q:90/h:486/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTI1MTkx/NDQtMTU0ODA2MzE5/Ni03ODU1LmpwZWc.jpeg","imageThumb":"https://i.discogs.com/p8gaNNQPBkXG-ijUtySxo7Fo30nFY7hwq6rbAC08G_s/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTI1MTkx/NDQtMTU0ODA2MzE5/Ni03ODU1LmpwZWc.jpeg","profile":"American, Icelandic singer, songwriter, producer and saxophonist\r\nBorn Jason Nemor Harden on the 4th August 1971 in Houston, Texas. He is now better known as Jay Nemor, a multi-talented artist, not only a quality vocalist but a consummate songwriter, composer, producer and also skilled with both saxophone and keyboards.\r\nJay was a professional basketball player in the States, the sport would then take him to Europe where he still resides with his family.   It was whilst in Iceland playing Basketball that his love of music was sparked and the seeds of a career in Soul music were sown. He borrowed some keyboards which he learnt to play and composed several songs. In 2004 he teamed up with former Motown artist Kenya to form Kenya Nemor later to become Kenya and Nemor. As well as this duet he would work as a session musician as well as more composing and producing various acts in varying genres.   A move to Oslo and later Gothenburg to try and further his career on a bigger stage with a larger market.\r\nJay was influenced by the likes of Earth Wind and Fire, Marvin Gaye, The Four Tops, temptations, Bobby Womack and many more, his style is loyal to these influences, typically old school in style but also right up to date with today’s R&B/Soul market.","provider":"discogs","ref":"discogs:artist:2519144","relations":{"aliases":[{"id":6668677,"name":"Jason Harden"}],"groups":[{"active":true,"id":5627732,"name":"Kenya & Nemor"}],"members":null,"namevariations":["J. Harden","J. Nemor","J. Nemor Harden"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/2519144-Jay-Nemor","type":"artist","urls":["http://www.jaynemor.com","https://jaynemor.bandcamp.com","https://soundcloud.com/jaynemor","https://www.facebook.com/jaynemorartist/"]}},"/api/discogs/artist/378086/profile":{"cached":true,"profile":{"id":"378086","image":"","imageThumb":"","profile":"","provider":"discogs","ref":"discogs:artist:378086","relations":{"aliases":null,"groups":[{"active":true,"id":704841,"name":"Sir Coxson Sound"}],"members":null,"namevariations":["R. Tuffy","Tuffy"]},"schemaVersion":2,"sourceUrl":"https://www.discogs.com/artist/378086-Ricky-Tuffy","type":"artist","urls":[]}},"/api/discogs/artist/4039564/profile":{"cached":true,"profile":{"id":"4039564","image":"https://i.discogs.com/Vko9jr0CcpfPU60bXaabJttZ7CZwOw59qkU8QIWFImA/rs:fit/g:sm/q:90/h:540/w:540/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9BLTQwMzk1/NjQtMTc3MD